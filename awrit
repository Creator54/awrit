#!/usr/bin/env bash
#: Run awrit with all Electron dependencies from nix-shell
#:
#: Usage:
#:   ./awrit [options] [url]
#:
#: For Kitty keybinding (kitty.conf):
#:   map ctrl+shift+b launch --location=split --cwd=current ./awrit

export AWRIT_CALLER_CWD="${AWRIT_CALLER_CWD:-$PWD}"
cd "$(dirname "$0")"

# Evaluating shell.nix takes seconds, so reuse a saved copy of its environment, keyed by the
# files it is built from. Any failure here falls through to nix-shell below.
if command -v nix >/dev/null 2>&1 && [ -z "$IN_NIX_SHELL" ] && [ -f "shell.nix" ] && [ -e .git ]; then
  cache="${XDG_CACHE_HOME:-$HOME/.cache}/awrit/dev-env"
  if files=$(git ls-files -co --exclude-standard -z -- shell.nix flake.lock package.json awrit-native-rs | xargs -0r sha256sum) &&
    [ -n "$files" ]; then
    key=$(printf '%s\n' "$(uname -m)" "$files" | sha256sum | cut -c1-16)
  else
    key=
  fi
  if [ -n "$key" ] && [ ! -s "$cache/$key.sh" ] && mkdir -p "$cache" && tmp=$(mktemp "$cache/.env.XXXXXX"); then
    # The profile keeps the environment's store paths from garbage collection.
    if nix --extra-experimental-features nix-command print-dev-env --profile "$cache/profile" -f shell.nix > "$tmp"; then
      mv -f "$tmp" "$cache/$key.sh"
      for old in "$cache"/*.sh; do [ "$old" = "$cache/$key.sh" ] || rm -f "$old"; done
      for link in "$cache"/profile-*-link; do [ "$link" -ef "$cache/profile" ] || rm -f "$link"; done
    else
      rm -f "$tmp"
    fi
  fi
  if [ -n "$key" ] && [ -s "$cache/$key.sh" ]; then
    saved_tmp=$(export -p | grep -E '^declare -x (TMP|TMPDIR|TEMP|TEMPDIR)=')
    # shellcheck disable=SC1090
    source "$cache/$key.sh"
    # The saved env makes a build directory that nix-shell would have removed on exit.
    rm -rf "$NIX_BUILD_TOP"
    unset NIX_BUILD_TOP TMP TMPDIR TEMP TEMPDIR
    eval "$saved_tmp"
  fi
fi

# Auto-enter nix-shell if available and not already inside one
if command -v nix-shell >/dev/null 2>&1 && [ -z "$IN_NIX_SHELL" ] && [ -f "shell.nix" ]; then
  ARGS=()
  for arg in "$@"; do
    ARGS+=("$(printf "%q" "$arg")")
  done
  exec nix-shell "shell.nix" --run "exec bash \"$0\" ${ARGS[*]}"
fi

if [ ! -d "node_modules" ] && command -v bun >/dev/null 2>&1; then
  bun install || true
fi

# Restore terminal on ANY exit (crash, SIGKILL, etc.)
# Prevents raw keyboard mode from sticking and breaking all input
cleanup() {
  printf '\e[>4u'  2>/dev/null  # Pop keyboard enhancement flags
  printf '\e[?1000l' 2>/dev/null  # Disable mouse tracking
  printf '\e[?1002l' 2>/dev/null
  printf '\e[?1003l' 2>/dev/null
  printf '\e[?1004l' 2>/dev/null  # Disable focus tracking
  printf '\e[?2004l' 2>/dev/null  # Disable bracketed paste
  printf '\e[?25h' 2>/dev/null    # Show cursor
  printf '\e[?7h' 2>/dev/null     # Enable auto-wrap
  stty sane 2>/dev/null           # Restore cooked mode
}
trap cleanup EXIT

exec bun run ./src/runner "$@"
